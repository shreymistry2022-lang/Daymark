{
  "expo": {
    "name": "Daymark",
    "slug": "Daymark",
    "scheme": "daymark",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.daymark.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.daymark.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1B1D22",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/94eaf616-1120-4262-897f-60d7e3e8b2d5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-system-ui",
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#10B981",
          "defaultChannel": {
            "name": "Habit reminders",
            "importance": "max",
            "vibrationPattern": [0, 250, 200, 250],
            "lightColor": "#10B981"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "DaymarkTodayWidget",
              "displayName": "Daymark Today",
              "description": "See today's habit progress at a glance",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "94eaf616-1120-4262-897f-60d7e3e8b2d5"
      }
    },
    "owner": "shrey_mistry"
  }
}
