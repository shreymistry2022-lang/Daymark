# Supabase Cloud Configuration
# Find these in your Supabase project: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-actual-anon-key-here
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-revenuecat-ios-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-revenuecat-android-public-sdk-key
EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=daymark_pro_monthly
EXPO_PUBLIC_REVENUECAT_ANNUAL_PRODUCT_ID=daymark_pro_annual
EXPO_PUBLIC_TERMS_URL=https://your-domain.example/terms
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.example/privacy
